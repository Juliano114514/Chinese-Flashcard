  "reasons": {
    "wl_13974": [
      "过得 uses lexical 过 and complement marker 得 de, not experiential 过 or 得 dé."
    ],
    "wl_01083": [
      "Separate syllables to preserve one-character/one-syllable alignment in sentence chunks."
    ],
    "wl_09955": [
      "Retain the independent medical headword 儿科 at its stable ID; refine its definition and natural pediatric-care examples, separately from colloquial 小儿科."
    ],
    "wl_17514": [
      "Select the spatial reading and meaning used by the examples, rather than an unrelated extended adverbial construction."
    ],
    "wl_18106": [
